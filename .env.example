# ClinDigest MCP Server — Environment Variables

# Transport mode: "stdio" (local dev) or "http" (remote deployment)
TRANSPORT=http

# Port for HTTP transport (default: 3000)
PORT=3000

# Anthropic API key for LLM-powered summary generation
# If not set, tools return structured prompts for the calling agent to generate
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
