{
  "name": "clindigest-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that generates contextual clinical summaries from FHIR R4 patient data",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "inspect": "npx @modelcontextprotocol/inspector"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "fhir",
    "healthcare",
    "clinical-summary",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
